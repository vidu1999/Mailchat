# MailChat configuration.
#
# Usage: copy this file to `assets/config/env` (same folder, no extension) and
# fill in the values. `flutter run` then needs no flags at all.
#
# Do NOT commit `assets/config/env` — it is gitignored. This .example file is
# the committed template.
#
# Format: KEY=value, one per line. Blank lines and lines starting with # are
# ignored. Quotes around a value are optional and are stripped.
#
# The app also reads --dart-define, which takes priority over this file. That is
# how CI and release builds are configured (see docs/release.md).

# --- Required -------------------------------------------------------------

# Supabase Dashboard -> Project Settings -> API -> Project URL
# e.g. https://abcdefghijklmnop.supabase.co
# A bare host without https:// also works; it is normalised at startup.
SUPABASE_URL=https://your-project-ref.supabase.co

# Project Settings -> API -> Project API keys -> `anon` / `public`.
# NEVER put the `service_role` key here: it bypasses every RLS policy, and
# everything in this file is compiled into the APK. `tool/check_config.dart`
# refuses to build if the service-role key is present.
SUPABASE_ANON_KEY=your-anon-key-here

# --- Optional -------------------------------------------------------------

# development | staging | production
APP_ENV=development

# Shown in the UI.
APP_NAME=MailChat

# Deep link registered in Supabase -> Authentication -> URL Configuration.
AUTH_REDIRECT_URL=mailchat://auth/callback

# Mirrors Supabase -> Authentication -> Providers -> Email -> Confirm email.
# true  = signup returns no session and the user must click the emailed link
# false = signup signs the user straight in
EMAIL_CONFIRMATION_REQUIRED=true

# Storage buckets (created by supabase/migrations/0004).
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_ATTACHMENTS=attachments

# Push notifications — unused until FCM is actually implemented.
# FCM_PROJECT_ID=
# FCM_VAPID_KEY=

# NOT in this file: SMTP credentials (configure in Supabase -> Authentication ->
# Emails -> SMTP) and the service_role key (server-side only). Both would end up
# inside the APK. See .env.example at the project root.
