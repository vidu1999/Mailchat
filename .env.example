# MailChat environment configuration — TEMPLATE.
#
# Copy to `.env`, fill in the two required values, then run the app:
#   PowerShell:  Copy-Item .env.example .env
#   bash:        cp .env.example .env
#   flutter run          (or .\run.ps1, which copies .env -> assets/config/env)
#
# `.env` is gitignored. `run.ps1` / `run.sh` / `tool/build_apk.*` copy it to
# `assets/config/env`, which is the file the app actually reads at runtime.
#
# READ THIS: everything in `assets/config/env` is compiled into the APK, where
# anyone can unzip it and read it. Only public, client-safe values belong here.
# Server-side credentials (service_role key, SMTP password) must NOT be in this
# file — tool/check_config.dart will refuse to build if they are.

# --- Supabase (required) --------------------------------------------------
# Dashboard -> Project Settings -> API.
# The URL is https://<project-ref>.supabase.co. If you leave it blank,
# `dart run tool/check_config.dart` derives it from your key and prints it.
SUPABASE_URL=https://your-project-ref.supabase.co

# The `anon` / `public` key. Safe to ship: it is protected by RLS.
# New-style keys (`sb_publishable_...`) work too.
SUPABASE_ANON_KEY=your-anon-public-key

# --- Application ----------------------------------------------------------
APP_NAME=MailChat

# development | staging | production
APP_ENV=development

# Deep link Supabase redirects to after verifying an emailed token. Must also be
# listed under Authentication -> URL Configuration -> Redirect URLs, or GoTrue
# ignores it and falls back to the Site URL. See docs/auth-links.md.
AUTH_REDIRECT_URL=mailchat://auth/callback

# Mirrors Authentication -> Providers -> Email -> Confirm email.
# true  = signup sends a link and returns no session
# false = signup signs the user in immediately
EMAIL_CONFIRMATION_REQUIRED=true

# --- Storage --------------------------------------------------------------
# Buckets created by supabase/migrations/0004.
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_ATTACHMENTS=attachments

# --- Calls ----------------------------------------------------------------
# A call carries real audio/video over WebRTC. STUN finds this device's public
# address; Google's server is fine on the same Wi-Fi, and a hosted TURN provider
# usually publishes its own, which is equally fine.
STUN_URL=stun:stun.l.google.com:19302

# Optional private TURN relay. A public global relay is already built in, so
# two phones on different networks can call without these lines. Paste your
# own list only if you want a private relay in front of the public one.
#
# Paste the WHOLE list the provider gives you -- on ONE line, comma-separated
# -- not just its first entry. The addresses differ by transport, and the TCP
# and TLS ones are what get through a network that drops UDP (most mobile data,
# most guest Wi-Fi). They all share one username/credential. Pasting the
# provider's raw `iceServers` JSON works too; quotes, braces and its `stun:`
# entry are ignored. `http(s)://` entries are rewritten to `turn(s):`.
#
# Example, hosted relay (addresses as the Metered dashboard prints them):
# TURN_URL=turn:global.relay.metered.ca:80,turn:global.relay.metered.ca:80?transport=tcp,turn:global.relay.metered.ca:443,turns:global.relay.metered.ca:443?transport=tcp
# TURN_USERNAME=your-credential-username
# TURN_CREDENTIAL=your-credential-password
#
# Check the paste before building: `dart run tool/check_config.dart` prints
# "relay: 4 addresses". Steps: docs/calls.md, "Setting up a hosted TURN relay".
# Without a relay, calls connect on the same network and can fail beyond it --
# the call screen warns about that.

# --- Firebase public app identifiers --------------------------------------
# Android uses the ignored android/app/google-services.json client config.
# FCM_VAPID_KEY is web-only. FCM_SERVICE_ACCOUNT_JSON and webhook secrets
# belong in Supabase Edge Function secrets, never in this app env file.
# FCM_PROJECT_ID=
# FCM_VAPID_KEY=

# ==========================================================================
# NOT FOR THIS FILE — configure these in the dashboards instead
# ==========================================================================
#
# SMTP (host / port / user / password)
#    Supabase Dashboard -> Authentication -> Emails -> SMTP Settings.
#    The app never sends email; it only asks Supabase to. Putting an SMTP
#    password here would bundle that password into every APK.
#
# Service-role key (SUPABASE_SERVICE_ROLE_KEY)
#    Bypasses every RLS policy — i.e. full read/write on the whole database.
#    Belongs only in trusted server-side code (Edge Functions), passed as a
#    secret there. Never in `.env` for a mobile build: check_config.dart treats
#    its presence as a build failure.
