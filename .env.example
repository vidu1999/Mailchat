# MailChat environment configuration
# Copy this file to .env (development) or set equivalent environment variables
# for staging/production. Never commit real secrets to Git.

# --- Supabase ---
# Obtain from your Supabase project: Settings > API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
# Service-role key MUST ONLY be used in trusted server-side code (Edge Functions).
# Never ship it inside the mobile application.
# SERVER-SIDE ONLY — never put this in the app or a mobile build.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- Application ---
APP_NAME=MailChat
# development | staging | production
APP_ENV=development

# Supabase Auth redirect URLs (configure in Supabase Dashboard > Authentication >
# URL Configuration > Redirect URLs)
# Example: mailchat://auth/callback
AUTH_REDIRECT_URL=mailchat://auth/callback

# --- Firebase Cloud Messaging (push notifications) ---
# Obtain from Firebase Console > Project settings > Cloud Messaging
# Android: google-services.json placed at android/app/google-services.json
# iOS: GoogleService-Info.plist added to the Xcode project
FCM_VAPID_KEY=your-vapid-key
FCM_PROJECT_ID=your-fcm-project-id

# --- Email delivery (SMTP) ---
# Configure in Supabase Dashboard > Authentication > Email Templates / SMTP.
# Supabase can send via its built-in SMTP (resend rate limited on free tier) or
# a custom SMTP provider. See docs/authentication.md for setup instructions.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=your-smtp-user
SMTP_PASS=your-smtp-password

# --- Storage ---
STORAGE_BUCKET_AVATARS=avatars
STORAGE_BUCKET_ATTACHMENTS=attachments
